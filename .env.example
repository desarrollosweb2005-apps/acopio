# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Email de la única cuenta que puede entrar
ALLOWED_EMAIL=tu-email@ejemplo.com

# Opcional: API de YouTube (gratis en Google Cloud). Si YouTube bloquea la lectura
# desde Vercel, con esta clave se obtienen siempre la duración y la descripción.
YOUTUBE_API_KEY=

# IA (fase 2): clave de console.groq.com. Sin ella, la app funciona igual pero sin IA.
GROQ_API_KEY=
# Opcional: forzar un modelo concreto de Groq (por defecto openai/gpt-oss-120b, con cambio automático si se retira)
GROQ_MODEL=
