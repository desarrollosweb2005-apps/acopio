{
  "manifest_version": 3,
  "name": "Acopio",
  "version": "1.1.0",
  "description": "Guarda la página, cualquier link, el texto seleccionado o una zona recortada de la página en tu biblioteca Acopio.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Guardar esta página en Acopio (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Guardar la página actual en Acopio"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Capturar una zona de la página"
    }
  },
  "host_permissions": [
    "https://*.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
